<Project>
    <ItemGroup>
        <ResXLocalizeResource Include="@(EmbeddedResource->WithMetadataValue('Extension', '.resx'))"/>
        <EmbeddedResource Remove="@(ResXLocalizeResource)"/>
        <AdditionalFiles Include="@(ResXLocalizeResource)"/>
    </ItemGroup>

    <Target Name="ResXLocalizeAssignCulture"
            BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile"
            Condition="'@(ResXLocalizeResource)' != ''">
        <AssignCulture Files="@(ResXLocalizeResource)">
            <Output TaskParameter="AssignedFiles" ItemName="_ResXLocalizeResourceWithCulture"/>
        </AssignCulture>

        <ItemGroup>
            <AdditionalFiles Remove="@(ResXLocalizeResource)"/>
            <AdditionalFiles Include="@(_ResXLocalizeResourceWithCulture)"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Culture"/>
        <CompilerVisibleProperty Include="XmlnsDefinitionNamespace"/>
        <CompilerVisibleProperty Include="ResxNamespace"/>
        <CompilerVisibleProperty Include="DefaultLocalizationProvider"/>
    </ItemGroup>
</Project>
